+local function utf8_codepoint(cp)
+    if cp < 0x80 then return string.char(cp) end
+    if cp < 0x800 then return string.char(0xC0 + math.floor(cp / 0x40), 0x80 + cp % 0x40) end
+    if cp < 0x10000 then return string.char(0xE0 + math.floor(cp / 0x1000), 0x80 + math.floor(cp / 0x40) % 0x40, 0x80 + cp % 0x40) end
+    return string.char(0xF0 + math.floor(cp / 0x40000), 0x80 + math.floor(cp / 0x1000) % 0x40, 0x80 + math.floor(cp / 0x40) % 0x40, 0x80 + cp % 0x40)
+end
+
+local function latin1_to_utf8(value)
+    return (value:gsub(".", function(c)
+        local n = c:byte()
+        return n < 128 and c or utf8_codepoint(n)
+    end))
+end
+
+local function decode_id3_text(value)
+    if not value or #value == 0 then return "" end
+    local encoding = value:byte(1)
+    local data = value:sub(2):gsub("%z+$", "")
+    if encoding == 3 then return data end
+    if encoding == 0 then return latin1_to_utf8(data) end
+    if encoding ~= 1 and encoding ~= 2 then return "" end
+    local little = encoding == 1 and data:sub(1, 2) == "\255\254"
+    if encoding == 1 and (data:sub(1, 2) == "\255\254" or data:sub(1, 2) == "\254\255") then data = data:sub(3) end
+    local out, i = {}, 1
+    while i + 1 <= #data do
+        local a, b = data:byte(i, i + 1)
+        local cp = little and (b * 256 + a) or (a * 256 + b)
+        i = i + 2
+        if cp == 0 then break end
+        if cp >= 0xD800 and cp <= 0xDBFF and i + 1 <= #data then
+            local c, d = data:byte(i, i + 1)
+            local low = little and (d * 256 + c) or (c * 256 + d)
+            if low >= 0xDC00 and low <= 0xDFFF then
+                cp = 0x10000 + (cp - 0xD800) * 0x400 + low - 0xDC00
+                i = i + 2
+            end
+        end
+        if cp < 0xD800 or cp > 0xDFFF then out[#out + 1] = utf8_codepoint(cp) end
+    end
+    return table.concat(out)
+end
