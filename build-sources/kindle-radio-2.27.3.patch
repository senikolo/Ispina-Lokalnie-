+local function id3_tags(path)
+    local file = io.open(path or "", "rb")
+    if not file then return {} end
+    local result = {}
+    local header = file:read(10) or ""
+    if #header == 10 and header:sub(1, 3) == "ID3" then
+        local major = header:byte(4)
+        local flags = header:byte(6)
+        local a, b, c, d = header:byte(7, 10)
+        local tag_size = ((a % 128) * 2097152) + ((b % 128) * 16384) + ((c % 128) * 128) + (d % 128)
+        local pos, stop = 11, 10 + tag_size
+        if major >= 2 and major <= 4 and tag_size <= 16777216 then
+            if major == 4 and flags % 64 >= 8 then pos = pos + 4; file:seek("set", pos - 1) end
+            while pos < stop do
+                file:seek("set", pos - 1)
+                local fh = file:read(major == 2 and 6 or 10) or ""
+                if #fh < (major == 2 and 6 or 10) or fh:byte(1) == 0 then break end
+                local id, size, skip
+                if major == 2 then
+                    id = fh:sub(1, 3)
+                    size = fh:byte(4) * 65536 + fh:byte(5) * 256 + fh:byte(6)
+                    skip = 6
+                else
+                    id = fh:sub(1, 4)
+                    local x, y, z, w = fh:byte(5, 8)
+                    if major == 4 then size = (x % 128) * 2097152 + (y % 128) * 16384 + (z % 128) * 128 + (w % 128)
+                    else size = x * 16777216 + y * 65536 + z * 256 + w end
+                    skip = 10
+                end
+                local wanted = id == "TIT2" or id == "TPE1" or id == "TT2" or id == "TP1"
+                if size <= 65536 and wanted then
+                    local text = decode_id3_text(file:read(size) or ""):gsub("^%s+", ""):gsub("%s+$", "")
+                    if id == "TIT2" or id == "TT2" then result.title = text
+                    else result.artist = text end
+                end
+                pos = pos + skip + size
+            end
+        end
+    end
+    if not result.title or result.title == "" or not result.artist or result.artist == "" then
+        local length = file:seek("end") or 0
+        if length >= 128 then
+            file:seek("set", length - 128)
+            local tag = file:read(128) or ""
+            if tag:sub(1, 3) == "TAG" then
+                local function field(value)
+                    return latin1_to_utf8((value or ""):gsub("%z", ""):gsub("%s+$", ""))
+                end
+                if not result.title or result.title == "" then result.title = field(tag:sub(4, 33)) end
+                if not result.artist or result.artist == "" then result.artist = field(tag:sub(34, 63)) end
+            end
+        end
+    end
+    file:close()
+    return result
+end
