+session_process() {
+    pid=$1
+    expected=$2
+    case "$pid" in ''|*[!0-9]*) return 1;; esac
+    [ -n "$expected" ] && [ -r "/proc/$pid/environ" ] || return 1
+    tr '\000' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -F -x "ILRADIO_K3_SESSION=$expected" >/dev/null 2>&1
+}
+
 is_ours() {
     [ -r "$PID" ] && [ -r "$TOKEN" ] || return 1
     p=$(cat "$PID" 2>/dev/null)
     token=$(cat "$TOKEN" 2>/dev/null)
-    case "$p" in ''|*[!0-9]*) return 1;; esac
-    [ -n "$token" ] && [ -r "/proc/$p/environ" ] || return 1
-    tr '\000' '\n' <"/proc/$p/environ" 2>/dev/null | grep -F -x "ILRADIO_K3_SESSION=$token" >/dev/null 2>&1
+    session_process "$p" "$token"
+}
+
+signal_session_tree() {
+    expected=$1
+    signal=$2
+    skip=${3:-}
+    case "$expected" in ''|*[!0-9-]*) return 1;; esac
+    for env_file in /proc/[0-9]*/environ; do
+        pid=${env_file#/proc/}
+        pid=${pid%/environ}
+        [ "$pid" = "$skip" ] && continue
+        if [ -r "$env_file" ] && (tr '\000' '\n' < "$env_file") 2>/dev/null | grep -F -x "ILRADIO_K3_SESSION=$expected" >/dev/null 2>&1; then
+            kill -"$signal" "$pid" 2>/dev/null || :
+        fi
+    done
+}
+
+proc_start_time() {
+    [ -r "/proc/$1/stat" ] || return 1
+    sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'
 }
 
