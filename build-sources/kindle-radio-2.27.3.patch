+    local under_root = false
+    for _, root in ipairs(roots) do
+        if path:sub(1, #root + 1) == root .. "/" then under_root = true; break end
+    end
+    return under_root and not path:find("/../", 1, true) and not path:find("/./", 1, true)
+        and lfs.symlinkattributes(path, "mode") == "file"
+end
