+    downloader=$!
+    trap 'kill "$downloader" "$reader" 2>/dev/null; rm -f "$prefix".*; exit 0' TERM INT HUP
+    wait "$downloader"
+    result=$?
+    wait "$reader" 2>/dev/null || :
+    rm -f "$prefix.pipe"
+    printf '%s\n' "$result" > "$prefix.done"
